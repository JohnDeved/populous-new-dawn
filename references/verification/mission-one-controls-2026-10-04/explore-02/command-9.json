[{"action":"button","name":"Select and focus shaman"},{"action":"wait","ms":1200},{"action":"read","expression":"(() => {const s=window.testSceneRef.current,r=s.container.getBoundingClientRect();return [{x:0,z:-20},{x:0,z:-18}].map(p=>{const q=s.screen(p);return {...p,screen:{x:r.x+(q.x+1)*r.width/2,y:r.y+(1-q.y)*r.height/2}}})})()"}]
