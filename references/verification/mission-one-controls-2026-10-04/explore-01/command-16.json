[{"action":"button","name":"Menu"},{"action":"button","name":"Save checkpoint"},{"action":"until","expression":"(async()=>{const q=indexedDB.open('populous-new-dawn',1);const db=await new Promise((r,j)=>{q.onsuccess=()=>r(q.result);q.onerror=()=>j(q.error)});try{const r=db.transaction('checkpoints','readonly').objectStore('checkpoints').get('latest');const v=await new Promise((a,b)=>{r.onsuccess=()=>a(r.result);r.onerror=()=>b(r.error)});return v?.world?.turn===3476 && v.world.stats.trained===5}finally{db.close()}})()","timeout":30000},{"action":"reload"},{"action":"button","name":"Load checkpoint"},{"action":"bind"},{"action":"button","name":"Pause game"},{"action":"title","name":"followers"}]
