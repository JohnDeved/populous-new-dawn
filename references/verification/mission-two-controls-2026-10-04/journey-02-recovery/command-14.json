[
  {
    "action": "resume"
  },
  {
    "action": "until",
    "expression": "!window.testSceneRef.current.world.inputMask && !window.testSceneRef.current.world.paused",
    "timeout": 1000
  },
  {
    "action": "select",
    "kind": "shaman"
  },
  {
    "action": "map",
    "point": {
      "x": 91,
      "z": 119
    }
  },
  {
    "action": "until",
    "expression": "!window.testSceneRef.current.cameraMotion.active",
    "timeout": 10000
  },
  {
    "action": "title",
    "name": "spells"
  },
  {
    "action": "button",
    "name": "Blast, 4 shots"
  },
  {
    "action": "until",
    "expression": "window.testSceneRef.current.world.mode===\"blast\"",
    "timeout": 1000
  },
  {
    "action": "ground",
    "point": {
      "x": 91,
      "z": 119
    },
    "options": {
      "focus": false,
      "spell": "blast"
    }
  },
  {
    "action": "until",
    "expression": "window.testSceneRef.current.world.shots.blast===3",
    "timeout": 2000
  },
  {
    "action": "mark",
    "name": "blast-against-enemy-shaman"
  },
  {
    "action": "map",
    "point": {
      "x": -99,
      "z": -105
    }
  },
  {
    "action": "until",
    "expression": "!window.testSceneRef.current.cameraMotion.active",
    "timeout": 10000
  },
  {
    "action": "select",
    "kind": "brave",
    "modifier": "Control"
  },
  {
    "action": "until",
    "expression": "window.testSceneRef.current.world.selected.length===5",
    "timeout": 1000
  },
  {
    "action": "read",
    "expression": "(() => {const w=window.testSceneRef.current.world;return {turn:w.turn,reinforcementTrainees:w.selected,retainedBraves:w.units.filter(u=>u.team===\"blue\"&&u.kind===\"brave\"&&!w.selected.includes(u.id)).map(u=>u.id)}})()"
  },
  {
    "action": "entity",
    "collection": "buildings",
    "id": 1022,
    "options": {
      "focus": false
    }
  },
  {
    "action": "until",
    "expression": "window.testSceneRef.current.world.units.filter(u=>u.inside===1022).length>=5",
    "timeout": 60000
  },
  {
    "action": "pause"
  },
  {
    "action": "mark",
    "name": "reinforcements-admitted-after-blast"
  }
]
