[
  {
    "action": "resume"
  },
  {
    "action": "until",
    "expression": "!window.testSceneRef.current.world.inputMask && !window.testSceneRef.current.world.paused",
    "timeout": 1000
  },
  {
    "action": "map",
    "point": {
      "x": -99,
      "z": -105
    }
  },
  {
    "action": "until",
    "expression": "window.testSceneRef.current.world.mode===null && window.testSceneRef.current.world.selected.length===5",
    "timeout": 1000
  },
  {
    "action": "read",
    "expression": "(() => {const w=window.testSceneRef.current.world;return {turn:w.turn,trainees:[...w.selected],retainedOriginalBraves:w.units.filter(u=>[319,170,173,176].includes(u.id)&&u.kind===\"brave\"&&!w.selected.includes(u.id)).map(u=>u.id)}})()"
  },
  {
    "action": "entity",
    "collection": "buildings",
    "id": 1022,
    "options": {
      "focus": false
    }
  },
  {
    "action": "until",
    "expression": "window.testSceneRef.current.world.lastOrderTurn>5344",
    "timeout": 1000
  },
  {
    "action": "read",
    "expression": "(() => {const w=window.testSceneRef.current.world;return {turn:w.turn,lastOrderTurn:w.lastOrderTurn,selected:w.selected,work:w.units.filter(u=>w.selected.includes(u.id)).map(u=>({id:u.id,kind:u.kind,inside:u.inside,work:u.work}))}})()"
  },
  {
    "action": "until",
    "expression": "window.testSceneRef.current.world.units.filter(u=>u.inside===1022).length>=5",
    "timeout": 60000
  },
  {
    "action": "until",
    "expression": "window.testSceneRef.current.world.units.filter(u=>u.team===\"blue\"&&u.kind===\"warrior\"&&u.hp>0&&u.inside===null).length>=10",
    "timeout": 200000
  },
  {
    "action": "pause"
  },
  {
    "action": "title",
    "name": "spells"
  },
  {
    "action": "mark",
    "name": "ten-warriors-three-tornado"
  },
  {
    "action": "checkpoint"
  }
]
