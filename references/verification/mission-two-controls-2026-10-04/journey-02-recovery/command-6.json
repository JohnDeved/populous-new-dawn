    "expression": "(() => { const w=window.testSceneRef.current.world; return {turn:w.turn,selected:w.selected,plans:w.buildings.filter(b=>b.team===\"blue\"&&b.kind===\"hut\").map(b=>({id:b.id,x:b.x,z:b.z,progress:b.progress,logs:b.logs}))} })()"
  },
  {
    "action": "until",
    "expression": "window.testSceneRef.current.world.buildings.filter(b=>b.team===\"blue\"&&b.kind===\"hut\"&&b.progress===1).length>=3",
