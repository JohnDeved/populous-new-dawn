+test('component checkpoint preserves authored birth caches when sampled terrain changes before the next visit', async () => {
+  const store = createGameStore()
+  store.startMission(2)
+  let world = store.getWorld()
+  const effect = worshipBridge(world), initialized = structuredClone(effect.bridge)
+  assert.equal(initialized.turn, 1)
+  // Supplied state perturbation: distinguish birth-time sampling from deferred
+  // sampling. This does not model ordinary rendered terrain or absolute timing.
+  const x = (expectedTarget.x >>> 9) & 127, y = (expectedTarget.y >>> 9) & 127
+  for (const dy of [0, 1]) for (const dx of [0, 1])
+    world.land.heights[((y + dy) & 127) * 128 + ((x + dx) & 127)] = 1024
+  const land = { heights: world.land.heights.slice(), flags: world.land.flags.slice() }
+  const deferred = createLandBridge(expectedStart, expectedTarget)
+  stepLandBridge(land, deferred, () => {}, () => {})
+  assert.notEqual(deferred.heightStep, initialized.heightStep, 'The supplied change must distinguish sampling times')
+  await store.saveCheckpoint()
+  assert.ok(store.loadCheckpoint())
+  world = store.getWorld()
+  assert.deepEqual(world.effects.find(effect => effect.bridge).bridge, initialized)
+  const reference = structuredClone(initialized)
+  stepLandBridge(land, reference, () => {}, () => {})
+  tick(world, 1 / 12)
+  assert.deepEqual(world.effects.find(effect => effect.bridge).bridge, reference)
+  assert.equal(reference.turn, 2)
+  assert.equal(reference.heightStep, initialized.heightStep)
+  assert.deepEqual(world.land.heights, land.heights)
 })
 
