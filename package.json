{
  "name": "populous-first-dawn",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node scripts/orchestration/test-runner.mjs all",
    "test:level-start": "node --test tests/level-start.test.mjs tests/startup-burst-angles.test.mjs tests/startup-burst-height.test.mjs tests/startup-burst-observer.test.mjs",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit --checkers 1",
    "typecheck:legacy": "node node_modules/typescript/bin/tsc --noEmit",
    "check": "pnpm run typecheck && pnpm test && pnpm run parity:check && pnpm run orchestration:check",
    "parity": "node scripts/parity.mjs",
    "parity:check": "node scripts/parity.mjs check",
    "parity:render": "node scripts/parity.mjs render",
    "parity:record": "node scripts/parity.mjs record",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "format": "oxfmt \"app/**/*.{ts,tsx}\"",
    "format:check": "oxfmt --check \"app/**/*.{ts,tsx}\"",
    "lint:standard": "oxlint app",
    "quality:health": "fallow health --hotspots --targets",
    "quality:dupes": "fallow dupes",
    "quality:unused": "fallow dead-code",
    "test:sprites": "node --test tests/sprite-layers.test.mjs && node scripts/check-browser-sprite-layers.mjs && node scripts/check-browser-unit-shadows.mjs && node scripts/check-browser-selection.mjs",
    "orchestration:check": "node scripts/orchestration/cli.mjs check",
    "orchestration:index": "node scripts/orchestration/cli.mjs index",
    "orchestration:context": "node scripts/orchestration/cli.mjs context",
    "orchestration:plan": "node scripts/orchestration/cli.mjs plan",
    "orchestration:preflight": "node scripts/orchestration/preflight.mjs",
    "orchestration:prepare": "node scripts/orchestration/prepare.mjs",
    "orchestration:verify": "node scripts/orchestration/verify.mjs",
    "orchestration:audit": "node scripts/orchestration/cli.mjs audit",
    "orchestration:review-bundle": "node scripts/orchestration/review-bundle.mjs",
    "orchestration:receipt": "node scripts/orchestration/command-receipt.mjs",
    "build:cloudflare": "PND_CLOUDFLARE=1 pnpm run build",
    "deploy:cloudflare": "pnpm run build:cloudflare && wrangler deploy --config dist/server/wrangler.json",
    "preview:cloudflare": "pnpm run build:cloudflare && wrangler versions upload --config dist/server/wrangler.json",
    "parity:measure": "node scripts/parity-measure.mjs",
    "test:mission6-earned": "node scripts/check-mission6-earned-victory.mjs",
    "test:focus": "node scripts/orchestration/test-runner.mjs focus",
    "test:serial": "node scripts/orchestration/test-runner.mjs serial"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fallow": "3.23.0",
    "globals": "16.4.0",
    "oxc-standard": "1.4.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
