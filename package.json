{
  "name": "populous-first-dawn",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run parity:check",
    "parity": "node scripts/parity.mjs",
    "parity:check": "node scripts/parity.mjs check",
    "parity:record": "node scripts/parity.mjs record",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "format": "oxfmt \"app/**/*.{ts,tsx}\"",
    "format:check": "oxfmt --check \"app/**/*.{ts,tsx}\"",
    "lint:standard": "oxlint app",
    "quality:health": "fallow health --hotspots --targets",
    "quality:dupes": "fallow dupes",
    "quality:unused": "fallow dead-code",
    "test:sprites": "node --test tests/sprite-layers.test.mjs && node scripts/check-browser-sprite-layers.mjs && node scripts/check-browser-unit-shadows.mjs && node scripts/check-browser-selection.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fallow": "3.23.0",
    "globals": "16.4.0",
    "oxc-standard": "1.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
