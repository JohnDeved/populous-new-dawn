+    return { history, phase: phase(p), orders: w.buildingOrders, person: p }
+  }
+  const expected = run([1 / 60])
+  for (const schedule of [[1 / 30], [1 / 120], [1 / 144], [.007, .021, .04]]) assert.deepEqual(run(schedule), expected)
+})
