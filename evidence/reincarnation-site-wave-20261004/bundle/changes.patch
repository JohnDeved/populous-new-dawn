+    assert.equal(w.reincarnationSites[0].h, expected)
+    assert.equal(fx.reincarnationWave.mode, 2)
+    assert.equal(fx.reincarnationWave.id, fx.id)
+    assert.equal(fx.reincarnationWave.visits, 0)
+  }
+})
