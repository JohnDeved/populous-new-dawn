+
+test('a wave removes an older in-cell Swamp before it can process in the same turn', () => {
+  const w = fixture(), friend = person(w, 'brave', {team:'blue'})
+  const trap = effect(w, 'swamp', browserPosition(center))
+  trap.duration = Infinity
