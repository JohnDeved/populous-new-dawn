+    assert.equal(u.native.state, 26)
+    assert.equal(u.native.timer, 64)
+    assert.equal(u.native.speed, 110)
+    assert.equal(u.native.turnAngle, 1534)
+    assert.equal(w.randomState, 1389729278)
+    const hp = u.hp
+    stepReincarnationWave(w, fx)
