++import assert from 'node:assert/strict'
++import { writeFileSync } from 'node:fs'
++import { resolve } from 'node:path'
++import { bindGame } from '../browser-game.mjs'
++import { openCampaignFromMainMenu } from '../browser-new-game.mjs'
++
++// Presentation fixture only: seed one route notice after real Home/scene startup.
++// This does not establish that a public gameplay command produces route failure.
++export default async function ({ page, output }) {
++  const observations = [], button = name => page.getByRole('button', { name, exact: true })
++  const record = value => {
++    observations.push(value)
++    writeFileSync(resolve(output, 'route-notice.json'), JSON.stringify({
++      scope: 'actual Home CSS/handlers with a controlled route-notice fixture', observations,
++    }, null, 2))
++  }
++  await page.setViewportSize({ width: 960, height: 720 })
++  await openCampaignFromMainMenu(page)
++  await button('Start Mission 1').click()
++  await bindGame(page)
++  await page.locator('.skip-introduction').click()
++  await page.waitForFunction(() => !window.testStore.getWorld().inputMask)
++  for (const initiallyPaused of [false, true]) {
++    if (initiallyPaused) await button('Pause game').click()
++    assert.equal(await page.evaluate(() => window.testStore.getWorld().paused), initiallyPaused)
++    await page.evaluate(() => {
++      const store = window.testStore, world = store.getWorld()
++      store.change(w => { w.routeNotice = { flags: 0x200000, message: 603, serial: (w.routeNotice?.serial ?? 0) + 1 } })
++      window.routeNoticeFixture = { world, notice: world.routeNotice, scene: window.testSceneRef.current,
++        canvas: document.querySelector('.world-viewport canvas') }
++    })
++    await page.locator('.route-notice').waitFor({ state: 'visible' })
++    await page.waitForTimeout(150)
++    await button('Game settings').click()
++    await page.getByRole('dialog', { name: 'Game menu', exact: true }).waitFor()
++    const observe = () => page.evaluate(() => {
++      const fixture = window.routeNoticeFixture, world = window.testStore.getWorld()
++      const node = document.querySelector('.route-notice'), animation = node?.getAnimations()[0]
++      return { sameWorld: world === fixture.world, sameNotice: world.routeNotice === fixture.notice,
++        sameScene: window.testSceneRef.current === fixture.scene, sceneWorld: fixture.scene.world === world,
++        sameCanvas: document.querySelector('.world-viewport canvas') === fixture.canvas,
++        paused: world.paused, suspended: fixture.scene.modalSuspended, turn: world.turn, time: world.time,
++        animationState: animation?.playState ?? null, animationTime: animation?.currentTime ?? null }
++    })
++    const before = await observe()
++    await page.waitForTimeout(3400)
++    const after = await observe()
++    record({ initiallyPaused, stage: 'hidden-longer-than-original-lifetime', before, after })
++    assert.equal(after.sameNotice, true, 'menu must retain the notice beyond its wall-clock lifetime')
++    assert.equal(after.animationState, 'paused')
++    assert.ok(Math.abs(after.animationTime - before.animationTime) < 60)
++    for (const key of ['sameWorld', 'sameScene', 'sceneWorld', 'sameCanvas', 'paused', 'suspended']) assert.equal(after[key], true)
++    assert.equal(after.turn, before.turn); assert.equal(after.time, before.time)
++    await button('Quit Level').click(); await button('No').click()
++    await button('Options').click(); await button('Browser compatibility and help').click()
++    await button('Select Level').click()
++    const selector = await observe()
++    assert.equal(selector.animationState, 'paused')
++    await page.keyboard.press('Escape')
++    await button('Continue Game').click()
++    await page.locator('.route-notice').waitFor({ state: 'visible' })
++    await button('Game settings').click()
++    await page.waitForTimeout(500)
++    assert.equal((await observe()).sameNotice, true)
++    await page.screenshot({ path: resolve(output, `route-notice-menu-${initiallyPaused}.png`) })
++    await page.keyboard.press('Escape')
++    assert.equal(await page.evaluate(() => window.testStore.getWorld().paused), initiallyPaused)
++    await page.waitForFunction(() => window.testStore.getWorld().routeNotice === null, null, { timeout: 5000 })
++    record({ initiallyPaused, stage: 'resumed-presentation-expired', final: await observe() })
++  }
++  return { status: 'passed', episodes: observations.length / 2, observations }
++}
+diff --git a/tests/route-notice-modal.test.mjs b/tests/route-notice-modal.test.mjs
+new file mode 100644
+index 00000000..b65a51c6
+--- /dev/null
++++ b/tests/route-notice-modal.test.mjs
+@@ -0,0 +1,75 @@
++import test from 'node:test'
++import assert from 'node:assert/strict'
++import ts from 'typescript'
++import { pageNode, pageSource, evaluatePage, pageNearby } from './support/follower-nearby-page.mjs'
++
++const notice = pageNode(node => ts.isJsxElement(node) &&
++  node.openingElement.attributes.properties.some(attribute =>
++    attribute.name?.getText(pageSource) === 'className' &&
++    attribute.initializer?.text === 'world-message route-notice'))
++
++// Execute Home's shipped JSX and menu handlers; this does not simulate CSS time.
++function fixture(paused = false) {
++  const makeWorld = () => ({ paused, routeNotice: { serial: 1 }, castingTribes: [{ flags: 0 }],
++    manaWorld: { gameFlags: 0 }, inputMask: 0 })
++  let world = makeWorld(), menu = false, selectorOpen = false
++  const scene = { world, cancelNearbyFollowers() {}, setModalSuspended(value) { this.modalSuspended = value } }
++  const store = { getWorld: () => world, change: action => action(world) }
++  const page = pageNearby(scene, { store, setMenu(value) { menu = value; if (value) selectorOpen = false },
++    setSelectorOpen(value) { selectorOpen = value } })
++  const render = () => evaluatePage(notice.getText(pageSource), {
++    store, world, routeNotice: world.routeNotice, menu, selectorOpen,
++    menuSession: page.bindings.menuSession, ROUTE_FAILURE_TEXT: 'Route failure',
++  })
++  return { page, scene, render, world: () => world,
++    inspect() { menu = false; page.openSelector() },
++    replace() { world = makeWorld(); return world },
++  }
++}
++
++for (const paused of [false, true]) {
++  test(`Home keeps the notice through menu/selector/reopen and restores prior pause=${paused}`, () => {
++    const ui = fixture(paused), original = ui.world().routeNotice
++    ui.page.openMenu()
++    const session = ui.page.bindings.menuSession.current
++    for (const action of [() => {}, () => ui.inspect(), () => ui.page.openMenu()]) {
++      action()
++      assert.equal(ui.page.bindings.menuSession.current, session)
++      assert.equal(ui.scene.modalSuspended, true)
++      const element = ui.render()
++      assert.equal(element.props.style.animationPlayState, 'paused')
++      assert.equal(ui.world().routeNotice, original)
++    }
++    ui.page.closeMenu()
++    assert.equal(ui.world().paused, paused)
++    assert.equal(ui.scene.modalSuspended, false)
++    assert.notEqual(ui.render().props.style.animationPlayState, 'paused')
++    ui.page.openMenu()
++    assert.equal(ui.render().props.style.animationPlayState, 'paused')
++    ui.page.closeMenu()
++    ui.render().props.onAnimationEnd()
++    assert.equal(ui.world().routeNotice, null)
++  })
++}
++
++test('ordinary game pause without a menu retains the presentation timer', () => {
++  const ui = fixture(true)
++  assert.equal(ui.page.bindings.menuSession.current, null)
++  assert.notEqual(ui.render().props.style.animationPlayState, 'paused')
++  ui.render().props.onAnimationEnd()
++  assert.equal(ui.world().routeNotice, null)
++})
++
++test('an obsolete animation callback cannot consume a replacement world notice with the same serial', () => {
++  const ui = fixture(), expired = ui.render().props.onAnimationEnd
++  const replacement = ui.replace(), retained = replacement.routeNotice
++  expired()
++  assert.equal(replacement.routeNotice, retained)
++})
++
++test('a canceled notice callback cannot consume a newly issued notice', () => {
++  const ui = fixture(), expired = ui.render().props.onAnimationEnd
++  ui.world().routeNotice = { serial: 2 }
++  expired()
++  assert.equal(ui.world().routeNotice.serial, 2)
++})
